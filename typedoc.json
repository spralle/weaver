{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.typedoc.json",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "packages/config-types/src/index.ts",
    "packages/config-engine/src/index.ts",
    "packages/config-runtime/src/index.ts",
    "packages/config-sessions/src/index.ts",
    "packages/config-auth/src/index.ts",
    "packages/config-policy/src/index.ts",
    "packages/config-sync/src/index.ts",
    "packages/storage-provider-local-storage/src/index.ts",
    "packages/storage-provider-static-json/src/index.ts",
    "packages/storage-providers/src/index.ts",
    "packages/weaver-server/src/index.ts",
    "packages/weaver-client/src/index.ts"
  ],
  "out": "docs-dist/api",
  "name": "Weaver API Reference",
  "readme": "none",
  "githubPages": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "categorizeByGroup": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "cleanOutputDir": true
}
