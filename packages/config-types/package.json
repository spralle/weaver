{
  "name": "@weaver-conf/config-types",
  "version": "0.1.0-pre.0",
  "description": "Core type definitions, Zod schemas, and the defineWeaver() builder for declaring layered configuration stacks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spralle/weaver.git",
    "directory": "packages/config-types"
  },
  "homepage": "https://github.com/spralle/weaver/tree/main/packages/config-types#readme",
  "bugs": {
    "url": "https://github.com/spralle/weaver/issues"
  },
  "keywords": [
    "weaver",
    "configuration",
    "config",
    "layered",
    "types",
    "schema",
    "zod"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/subpaths/schemas.d.ts",
      "import": "./dist/subpaths/schemas.js"
    },
    "./sync": {
      "types": "./dist/subpaths/sync.d.ts",
      "import": "./dist/subpaths/sync.js"
    },
    "./session": {
      "types": "./dist/subpaths/session.d.ts",
      "import": "./dist/subpaths/session.js"
    },
    "./access": {
      "types": "./dist/subpaths/access.d.ts",
      "import": "./dist/subpaths/access.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check ."
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
